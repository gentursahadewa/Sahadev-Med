<%- include('partials/header') %>

<h1 class="mb-4">
Edit Tensi
</h1>

<div class="card card-dark">

    <div class="card-body">

        <form
        method="POST"
        action="/vitals/blood-pressure/edit/<%= row.id %>">

            <div class="mb-3">

                <label class="form-label">

                    Waktu

                </label>

                <input
                type="datetime-local"
                name="measured_at"
                class="form-control"
                value="<%= row.measured_at %>"
                required>

            </div>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label class="form-label">

                        Sistolik

                    </label>

                    <input
                    type="number"
                    name="systolic"
                    class="form-control"
                    value="<%= row.systolic || '' %>">

                </div>

                <div class="col-md-6 mb-3">

                    <label class="form-label">

                        Diastolik

                    </label>

                    <input
                    type="number"
                    name="diastolic"
                    class="form-control"
                    value="<%= row.diastolic || '' %>">

                </div>

            </div>

            <div class="mb-3">

                <label class="form-label">

                    Catatan

                </label>

                <textarea
                name="note"
                class="form-control"
                rows="3"><%= row.note || '' %></textarea>

            </div>

            <div
            class="d-flex gap-2 flex-wrap">

                <button
                class="btn btn-success">

                    <i class="bi bi-floppy"></i>

                    Simpan

                </button>

        </form>

        <form
        method="POST"
        action="/vitals/blood-pressure/delete/<%= row.id %>"
        onsubmit="return confirm('Hapus data tensi ini?')">

            <button
            class="btn btn-danger">

                <i class="bi bi-trash"></i>

                Hapus

            </button>

        </form>

        <a
        href="/vitals/blood-pressure"
        class="btn btn-secondary">

            Kembali

        </a>

            </div>

    </div>

</div>

<%- include('partials/footer') %>