<%- include('partials/header') %>

<h1>

Detail Pemberian

</h1>

<p>

Waktu:

<%= rows[0].administered_at %>

</p>

<p>

Catatan:

<%= rows[0].note || "-" %>

</p>

<table
class="table table-dark">

<thead>

<tr>

<th>Obat</th>

<th>Jumlah</th>

</tr>

</thead>

<tbody>

<% rows.forEach(r=>{ %>

<tr>

<td>

<%= r.name %>

</td>

<td>

<%= r.amount %>
<%= r.unit %>

</td>

</tr>

<% }) %>

</tbody>

</table>

<%- include('partials/footer') %>

