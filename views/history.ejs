<%- include('partials/header') %>

<h1 class="mb-4">
    Riwayat
</h1>

<div class="row mb-4">

    <div class="col-md-4 mb-2">

        <input
            type="date"
            id="dateFilter"
            class="form-control">

    </div>

    <div class="col-md-4">

        <input
            type="text"
            id="searchInput"
            class="form-control"
            placeholder="Cari catatan atau nama obat">

    </div>

</div>


<div id="historyContainer">

    <% rows.forEach(r=>{ %>

    <div
        class="card card-dark mb-3 history-card"
        data-date="<%= r.administered_at %>"
        data-search="<%= (r.note || '') + ' ' + (r.medicine_names || '') %>">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-start flex-wrap">

                <div>

                    <h6 class="text-success mb-2">

                        <i class="bi bi-clock-history"></i>

                        <%
                        const dt = new Date(r.administered_at);
                        %>

                        <%= dt.toLocaleString(
                        'id-ID',
                        {
                            day:'2-digit',
                            month:'2-digit',
                            year:'numeric',
                            hour:'2-digit',
                            minute:'2-digit'
                        }
                        ) %>
                    </h6>

                    <div class="mb-2">

                        <span class="badge bg-success">

                            <%= r.total_items %> Obat

                        </span>

                    </div>

                </div>

            </div>


            <div class="mb-3">

                <strong>

                    <i class="bi bi-capsule"></i>

                    Obat:

                </strong>

                <div class="text-muted mt-1">

                    <%= r.medicine_names || '-' %>

                </div>

            </div>

            <div class="mb-3">

                <strong>

                    <i class="bi bi-journal-text"></i>

                    Catatan:

                </strong>

                <div class="text-muted mt-1">

                    <%= r.note || '-' %>

                </div>

            </div>

            <div class="d-flex gap-2">

                <a
                    href="/history/<%= r.id %>"
                    class="btn btn-info btn-sm">

                    <i class="bi bi-eye"></i>

                    Detail

                </a>
<% if(isLoggedIn){ %>
                <a
                href="/history/edit/<%=r.id%>"
                class="btn btn-warning btn-sm">

                <i class="bi bi-pencil"></i>

                Edit

                </a>

                <form
                    method="POST"
                    action="/history/delete/<%= r.id %>"
                    onsubmit="return confirm('Hapus pencatatan ini?')">

                    <button
                        class="btn btn-danger btn-sm">

                        <i class="bi bi-trash"></i>

                        Hapus

                    </button>

                </form>
<% } %>
            </div>

        </div>

    </div>

    <% }) %>

</div>


<script>

const dateFilter =
document.getElementById(
    "dateFilter"
);

const searchInput =
document.getElementById(
    "searchInput"
);

function filterHistory(){

    const dateValue =
    dateFilter.value;

    const searchValue =
    searchInput.value
    .toLowerCase();

    document
    .querySelectorAll(
        ".history-card"
    )
    .forEach(card=>{

        const cardDate =
        card.dataset.date;

        const cardSearch =
        card.dataset.search
        .toLowerCase();

        let show = true;

        if(
            dateValue &&
            !cardDate.startsWith(
                dateValue
            )
        ){
            show = false;
        }

        if(
            searchValue &&
            !cardSearch.includes(
                searchValue
            )
        ){
            show = false;
        }

        card.style.display =
        show
        ? "block"
        : "none";

    });

}

dateFilter.addEventListener(
    "input",
    filterHistory
);

searchInput.addEventListener(
    "input",
    filterHistory
);

</script>

<%- include('partials/footer') %>