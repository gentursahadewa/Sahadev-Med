<%- include('partials/header') %>

<h1 class="mb-4">
Edit Gula Darah
</h1>

<div class="card card-dark">

    <div class="card-body">

        <form
        method="POST"
        action="/vitals/glucose/edit/<%= row.id %>">

            <div class="mb-3">

                <label class="form-label">

                    Waktu

                </label>

                <input
                type="datetime-local"
                name="measured_at"
                class="form-control"
                value="<%= row.measured_at %>"
                required>

            </div>

            <div class="mb-3">

                <label class="form-label">

                    Gula Darah

                </label>

                <input
                type="number"
                step="0.1"
                name="blood_glucose"
                class="form-control"
                value="<%= row.blood_glucose %>">

            </div>

            <div class="mb-3">

                <label class="form-label">

                    Catatan

                </label>

                <textarea
                name="note"
                class="form-control"
                rows="3"><%= row.note || '' %></textarea>

            </div>

            <div
            class="d-flex gap-2">

                <button
                class="btn btn-success">

                    <i class="bi bi-floppy"></i>

                    Simpan

                </button>

        </form>

        <form
        method="POST"
        action="/vitals/glucose/delete/<%= row.id %>"
        onsubmit="return confirm('Hapus data ini?')">

            <button
            class="btn btn-danger">

                <i class="bi bi-trash"></i>

                Hapus

            </button>

        </form>
        <a
        href="/vitals/glucose"
        class="btn btn-secondary">

            Kembali

        </a>

            </div>

    </div>

</div>

<%- include('partials/footer') %>