<%- include('partials/header') %>

<h1 class="mb-4">
    Monitoring Kesehatan
</h1>

<% if(success && lastSaved){ %>

<div class="alert alert-success mb-4">

    <h5 class="mb-3">

        <i class="bi bi-check-circle"></i>

        Data kesehatan berhasil disimpan

    </h5>

    <hr>

    <p class="mb-2">

        <strong>Tanggal:</strong>

        <%= new Date(
            lastSaved.measured_at
        ).toLocaleString(
            "id-ID"
        ) %>

    </p>

    <% if(lastSaved.blood_glucose){ %>

    <p class="mb-2">

        <strong>Gula Darah:</strong>

        <%= lastSaved.blood_glucose %>
        mg/dL

    </p>

    <% } %>

    <% if(
        lastSaved.systolic &&
        lastSaved.diastolic
    ){ %>

    <p class="mb-2">

        <strong>Tensi:</strong>

        <%= lastSaved.systolic %>
        /
        <%= lastSaved.diastolic %>
        mmHg

    </p>

    <% } %>

    <% if(lastSaved.note){ %>

    <p class="mb-2">

        <strong>Catatan:</strong>

        <%= lastSaved.note %>

    </p>

    <% } %>

    <hr>

    <small>

        Jika terdapat kesalahan data,
        silakan buka atau klik

        <a
            href="/vitals/glucose"
            class="fw-bold text-success text-decoration-none">

            <i class="bi bi-droplet-half"></i>
            Detail Gula Darah

        </a>

        atau

        <a
            href="/vitals/blood-pressure"
            class="fw-bold text-success text-decoration-none">

            <i class="bi bi-heart-pulse"></i>
            Detail Tensi

        </a>

        untuk melakukan edit.

    </small>

</div>

<% } %>

<div class="card card-dark mb-4">

    <div class="card-body">

        <form
            method="POST"
            action="/vitals/save">

            <div class="row g-3">

                <div class="col-12 col-md-3">

                    <label class="form-label">
                        Tanggal & Jam
                    </label>

                    <input
                        type="datetime-local"
                        name="measured_at"
                        class="form-control"
                        required>

                </div>

                <div class="col-12 col-md-3">

                    <label class="form-label">
                        Gula Darah (mg/dL)
                    </label>

                    <input
                        type="number"
                        step="0.1"
                        name="blood_glucose"
                        class="form-control"
                        placeholder="Contoh: 125">

                </div>
                <div
                id="glucoseTypeContainer"
                class="mt-3"
                style="display:none;">

                    <label class="form-label">

                        Jenis Pemeriksaan

                    </label>

                    <div class="d-flex gap-2 flex-wrap">

                        <button
                        type="button"
                        class="btn btn-outline-info btn-sm glucose-type"
                        data-text="Gula Puasa">

                            Gula Puasa

                        </button>

                        <button
                        type="button"
                        class="btn btn-outline-warning btn-sm glucose-type"
                        data-text="Gula Sewaktu">

                            Gula Sewaktu

                        </button>
                        <button
                        type="button"
                        class="btn btn-outline-success btn-sm glucose-type"
                        data-text="2 Jam PP">

                            2 Jam PP

                        </button>

                    </div>

                </div>

                <div class="col-12 col-md-2">

                    <label class="form-label">
                        Sistolik
                    </label>

                    <input
                        type="number"
                        name="systolic"
                        class="form-control"
                        placeholder="120">

                </div>

                <div class="col-12 col-md-2">

                    <label class="form-label">
                        Diastolik
                    </label>

                    <input
                        type="number"
                        name="diastolic"
                        class="form-control"
                        placeholder="80">

                </div>

                <div class="col-12 col-md-2">

                    <label class="form-label">
                        &nbsp;
                    </label>

                    <button
                        class="btn btn-success w-100">

                        <i class="bi bi-floppy"></i>

                        Simpan

                    </button>

                </div>

            </div>

            <div class="mt-3">

                <textarea
                    name="note"
                    class="form-control"
                    rows="2"
                    placeholder="Catatan"></textarea>

            </div>

        </form>

    </div>

</div>

<div class="d-flex justify-content-center gap-2 flex-wrap mb-4">

    <a
    href="/vitals?days=7"
    class="btn <%= days==7 ? 'btn-success' : 'btn-outline-success' %>">

        7 Hari

    </a>

    <a
    href="/vitals?days=30"
    class="btn <%= days==30 ? 'btn-success' : 'btn-outline-success' %>">

        30 Hari

    </a>

    <a
    href="/vitals?days=90"
    class="btn <%= days==90 ? 'btn-success' : 'btn-outline-success' %>">

        90 Hari

    </a>

    <a
    href="/vitals?days=3650"
    class="btn <%= days==3650 ? 'btn-success' : 'btn-outline-success' %>">

        Semua

    </a>

</div>

<div class="row mb-4">

    <div class="col-12 col-lg-6 mb-3">

        <div class="card card-dark">

            <div class="card-body">

                <h4 class="mb-3">

                    <i class="bi bi-graph-up"></i>

                    Grafik Gula Darah

                </h4>

                <canvas
                    id="glucoseChart"
                    height="220">
                </canvas>

            </div>

        </div>

    </div>

    <div class="col-12 col-lg-6 mb-3">

        <div class="card card-dark">

            <div class="card-body">

                <h4 class="mb-3">

                    <i class="bi bi-heart-pulse"></i>

                    Grafik Tensi

                </h4>

                <canvas
                    id="bloodPressureChart"
                    height="220">
                </canvas>

            </div>

        </div>

    </div>

</div>

<div class="d-flex justify-content-center gap-2 flex-wrap mb-4">

    <a
        href="/vitals/glucose"
        class="btn btn-success">

        <i class="bi bi-droplet-half"></i>

        Detail Gula Darah

    </a>

    <a
        href="/vitals/blood-pressure"
        class="btn btn-primary">

        <i class="bi bi-heart-pulse"></i>

        Detail Tensi

    </a>

</div>


<script
type="application/json"
id="glucoseData">

<%- JSON.stringify(glucoseChartData || []) %>

</script>

<script
type="application/json"
id="bloodPressureData">

<%- JSON.stringify(bloodPressureChartData || []) %>

</script>

<script>

const glucoseData =
JSON.parse(
document
.getElementById(
"glucoseData"
)
.textContent
);

const glucoseLabels =
glucoseData.map(
x => x.measured_at
.replace("T"," ")
.substring(5,16)
);

const bloodPressureData =
JSON.parse(
document
.getElementById(
"bloodPressureData"
)
.textContent
);

const bpLabels =
bloodPressureData.map(
x => x.measured_at
.replace("T"," ")
.substring(5,16)
);

// Auto waktu sekarang

const nowInput =
document.querySelector(
'input[name="measured_at"]'
);

if(nowInput){

    const now =
    new Date();

    const offset =
    now.getTimezoneOffset();

    const local =
    new Date(
        now.getTime() -
        offset * 60000
    );

    nowInput.value =
    local
    .toISOString()
    .slice(0,16);

}

// Grafik gula darah

const glucoseCtx =
document.getElementById(
"glucoseChart"
);

if(
    glucoseCtx &&
    typeof Chart !== "undefined"
){

    new Chart(
        glucoseCtx,
        {

            type:"line",

            data:{

                labels: glucoseLabels,

                datasets:[{

                    label:"Gula Darah",

                    data:
                    glucoseData.map(
                        x => x.blood_glucose
                    ),

                    borderColor:"#1db954",

                    backgroundColor:"#1db954",

                    tension:.3

                }]

            },

            options:{

                responsive:true

            }

        }
    );

}

// Grafik tensi

const bpCtx =
document.getElementById(
"bloodPressureChart"
);

if(
    bpCtx &&
    typeof Chart !== "undefined"
){

    new Chart(
        bpCtx,
        {

            type:"line",

            data:{

                labels: bpLabels,

                datasets:[

                    {

                        label:"Sistolik",

                        data:
                        bloodPressureData.map(
                            x => x.systolic
                        ),

                        borderColor:"#0d6efd",

                        tension:.3

                    },

                    {

                        label:"Diastolik",

                        data:
                        bloodPressureData.map(
                            x => x.diastolic
                        ),

                        borderColor:"#dc3545",

                        tension:.3

                    }

                ]

            },

            options:{

                responsive:true

            }

        }
    );

}

// ======================
// Jenis gula darah
// ======================

const glucoseInput =
document.querySelector(
'input[name="blood_glucose"]'
);

const noteInput =
document.querySelector(
'textarea[name="note"]'
);

const glucoseTypeContainer =
document.getElementById(
"glucoseTypeContainer"
);

if(glucoseInput){

    glucoseInput.addEventListener(
    "input",
    ()=>{

        if(
        glucoseInput.value.trim()
        ){

            glucoseTypeContainer.style.display =
            "block";

        }else{

            glucoseTypeContainer.style.display =
            "none";

        }

    });

}

document
.querySelectorAll(
".glucose-type"
)
.forEach(
button=>{

    button.addEventListener(
    "click",
    ()=>{

        noteInput.value =
        button.dataset.text;

    });

});

</script>

<%- include('partials/footer') %>