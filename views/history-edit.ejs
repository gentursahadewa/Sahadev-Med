<%- include('partials/header') %>

<h1 class="mb-4">

    Edit Pencatatan

</h1>

<div class="card card-dark">

    <div class="card-body">

        <form
        method="POST"
        action="/history/edit/<%= record.id %>">

            <div class="mb-3">

                <label class="form-label">

                    Tanggal & Jam

                </label>

                <input
                type="datetime-local"
                name="administered_at"
                class="form-control"
                value="<%= record.administered_at.substring(0,16) %>"
                required>

            </div>

            <div id="medicineContainer">

                <% items.forEach(item=>{ %>

                <div class="medicine-row row g-2 mb-2">

                    <div class="col-md-7">

                        <select
                        name="medicine_id"
                        class="form-select">

                            <% medicines.forEach(m=>{ %>

                            <option
                            value="<%= m.id %>"
                            <%= item.medicine_id === m.id ? 'selected' : '' %>>

                                <%= m.name %>

                            </option>

                            <% }) %>

                        </select>

                    </div>

                    <div class="col-md-3">

                        <input
                        type="number"
                        step="0.01"
                        name="amount"
                        class="form-control"
                        value="<%= item.amount %>">

                    </div>

                    <div class="col-md-2">

                        <button
                        type="button"
                        class="btn btn-danger remove-btn w-100">

                            Hapus

                        </button>

                    </div>

                </div>

                <% }) %>

            </div>

            <button
            type="button"
            id="addMedicine"
            class="btn btn-success mt-2">

                + Tambah Obat

            </button>

            <div class="mt-4">

                <label class="form-label">

                    Catatan

                </label>

                <textarea
                name="note"
                class="form-control"
                rows="3"><%= record.note || '' %></textarea>

            </div>

            <div class="mt-4 d-flex gap-2">

                <button
                class="btn btn-primary">

                    Simpan Perubahan

                </button>

                <a
                href="/history"
                class="btn btn-secondary">

                    Batal

                </a>

            </div>

        </form>

    </div>

</div>

<div id="templateRow" style="display:none;">

    <div class="medicine-row row g-2 mb-2">

        <div class="col-md-7">

            <select
            name="medicine_id"
            class="form-select">

                <% medicines.forEach(m=>{ %>

                <option value="<%= m.id %>">

                    <%= m.name %>

                </option>

                <% }) %>

            </select>

        </div>

        <div class="col-md-3">

            <input
            type="number"
            step="0.01"
            name="amount"
            class="form-control">

        </div>

        <div class="col-md-2">

            <button
            type="button"
            class="btn btn-danger remove-btn w-100">

                Hapus

            </button>

        </div>

    </div>

</div>

<script>

document
.getElementById(
"addMedicine"
)
.addEventListener(
"click",
()=>{

    const row =
    document
    .querySelector(
    "#templateRow .medicine-row"
    )
    .cloneNode(true);

    document
    .getElementById(
    "medicineContainer"
    )
    .appendChild(row);

});

document
.addEventListener(
"click",
(e)=>{

    if(
    e.target.classList.contains(
    "remove-btn"
    )
    ){

        const rows =
        document.querySelectorAll(
        ".medicine-row"
        );

        if(
        rows.length > 1
        ){

            e.target
            .closest(
            ".medicine-row"
            )
            .remove();

        }

    }

});

</script>

<%- include('partials/footer') %>